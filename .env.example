NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional absolute path on persistent local disk; defaults to data/uploads.
# UPLOAD_DIR=C:/data/plated/uploads

# Use supabase on hosted deployments; local remains the development default.
STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET=restaurant-images
# Server-only secret: NEVER prefix with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical public origin when using a custom domain; Render auto-detects its URL.
# SITE_URL=https://your-domain.example
